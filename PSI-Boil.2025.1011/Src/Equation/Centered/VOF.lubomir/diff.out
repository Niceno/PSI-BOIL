<   if(vn2<0) {
<     ypos = 1.0-ypos;
<   }
<   if(vn3<0) {
<     zpos = 1.0-zpos;
<   }
< 
<   /* now, we need to translate the coordinate system */
<   /* so that x'(center of bnd cell) = (0.5,0.5,0.5)  */
<   /* x' = x - x(center of bnd cell) + (0.5,0.5,0.5)  */
<   /* this affects alpha value: */
